# 中文：复制本文件为 `.env` 用于本地开发，不要提交 `.env` 或真实密钥。
# English: Copy this file to `.env` for local development. Never commit `.env` or real API keys.

# 中文：可选 KAFU / OpenAI-compatible 大模型服务。
# English: Optional KAFU / OpenAI-compatible LLM provider.
KAFU_LLM_API_KEY=
KAFU_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KAFU_CHAT_MODEL=qwen3-max
KAFU_EMBEDDING_MODEL=text-embedding-v4
KAFU_VISION_MODEL=qwen3.6-plus
KAFU_RERANK_MODEL=qwen3-rerank

# 中文：可选 OpenAI/GPT-compatible 兜底模型服务。
# English: Optional OpenAI/GPT-compatible fallback provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
GPT_API_KEY=
GPT_BASE_URL=
GPT_CHAT_MODEL=

# 中文：可选 NASA API key；未配置时使用 DEMO_KEY。
# English: Optional NASA API key. The app falls back to DEMO_KEY when omitted.
NASA_API_KEY=

# 中文：成人设置页密码。
# English: Adult settings page password.
SETTINGS_PASSWORD=change-me-before-deploy
